{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-routing.cjs\" SessionStart",
            "timeout": 5,
            "statusMessage": "Enforcing Codex Hat routing..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-routing.cjs\" UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Enforcing Codex Hat routing..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-routing.cjs\" SubagentStart",
            "timeout": 5,
            "statusMessage": "Enforcing Codex Hat routing..."
          }
        ]
      }
    ]
  }
}
